{
  "name": "@deepseek-ai/dsh-typert-protocol",
  "description": "pinned-source vendor：DSH Typert 协议包（声明源），供 @deepseek-ai/dsh-typert-generator 的 workspace 识别使用（官方形态复刻，见 README）",
  "version": "0.2.2-rc.1-vendor.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "vendor": "node scripts/vendor-protocol.mjs",
    "vendor:check": "node scripts/vendor-protocol.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@types/node": "^24",
    "typescript": "^5.9",
    "vitest": "^5.0.3",
    "zod": "^4.4.3"
  }
}
